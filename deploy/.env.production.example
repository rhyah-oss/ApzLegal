# APZ Legal — production environment variables
# Copy this file to .env.production and fill in real values.
# Do NOT commit .env.production to version control.

NODE_ENV=production
PORT=3002

# Application
APP_URL=https://lexora.apztdg.com
FIRM_NAME=Smith & Partners Inc.
FIRM_JURISDICTION=ZA

# Session security — generate a strong random secret
SESSION_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# OpenAI
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# PostgreSQL (infra-postgres on infra_shared network)
DATABASE_URL=postgresql://apz_legal_replit:CHANGE_ME@postgres:5432/apz_legal_replit

# Redis (infra-redis on infra_shared network)
REDIS_URL=redis://:CHANGE_ME@redis:6379/3

# MinIO / S3 (infra-minio on infra_shared network).
S3_ENDPOINT=http://infra-minio:9000
PUBLIC_S3_ENDPOINT=https://storage.apztdg.com
S3_BUCKET=apz-legal-replit
S3_REGION=us-east-1
# Credentials are INJECTED at deploy time via the orchestrator environment
# (see deploy/docker-compose.yml `environment:` block) and must NOT be hard-coded
# in this file or committed to source. Compose interpolates them from the shell
# that runs `docker compose up`; leaving the placeholders below in place will
# make object storage unusable (the app then fails fast at startup).
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Object storage paths (format: bucketName/prefix). Required by the app.
# Private documents (matter docs, FICA files, knowledge attachments) live under
# <PRIVATE_OBJECT_DIR>/uploads/<uuid> and are served via /api/storage/objects/.
PRIVATE_OBJECT_DIR=apz-legal-replit/private
# Public assets are searched across these paths (comma-separated).
PUBLIC_OBJECT_SEARCH_PATHS=apz-legal-replit/public
