# Lexora AI — production environment (shared apztdg.com platform)
# Copy from .env.example and run scripts/deploy.sh to provision secrets.

# Public URL (Caddy TLS)
APP_URL=https://lexora.apztdg.com
NODE_ENV=production

# Firm (private deployment placeholder — single firm on shared dev host)
FIRM_NAME=Smith & Partners Inc.
FIRM_JURISDICTION=ZA

# ── Shared Postgres (infra_shared) ───────────────────────────────────────────
# Created via: cd /home/ubuntu/infra && ./scripts/create-app-db.sh lexora
DATABASE_URL=postgresql://lexora_app:CHANGE_ME@postgres:5432/lexora

# ── Shared Redis (logical DB 3 — 0–2 used by other apps) ─────────────────────
REDIS_URL=redis://:CHANGE_ME@redis:6379/3

# ── Shared MinIO ──────────────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=lexora
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ── Shared Qdrant (dedicated lexora_* collections) ──────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PREFIX=lexora_

# ── Shared Ollama (ai-models_default) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_TEXT_MODEL=qwen2.5:32b
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_MAX_CONCURRENCY=1

# ── Auth (Phase 2) ────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://lexora.apztdg.com
